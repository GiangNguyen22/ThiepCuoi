# ==============================================================================
# ThiepCuoiV2 - Environment Variables Configuration (.env.example)
# ==============================================================================
# Lưu ý quan trọng:
# 1. File này chỉ chứa các giá trị mẫu/giả định cho cấu hình hệ thống.
# 2. KHÔNG BAO GIỜ lưu thông tin mật, mật khẩu thực tế hoặc mã PIN vào Git.
# 3. Khi triển khai production, cấu hình các biến này trong Cloudflare Dashboard:
#    Workers & Pages > thiepcuoi-v2 > Settings > Environment variables.
# ==============================================================================

# [Tùy chọn] Tên miền chính thức của website thiệp cưới (dùng cho canonical URL & tạo mã QR)
CANONICAL_URL=https://thiepcuoi-v2.pages.dev

# [Tùy chọn] Cấu hình phiên làm việc quản trị viên (giờ)
ADMIN_SESSION_TTL_HOURS=24

# [Tùy chọn] Giới hạn tần suất gửi yêu cầu để chống spam (số lần / 10 phút)
RATE_LIMIT_MAX_WISHES=5
RATE_LIMIT_MAX_RSVPS=5
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=5

# [Chỉ dành cho Wrangler CLI khi quản lý từ xa qua terminal]
# Lấy từ Cloudflare Dashboard > Overview (bên phải): Account ID
# CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# CLOUDFLARE_API_TOKEN=fake_token_do_not_commit_real_tokens

# [ID D1 Database trên Cloudflare Production]
# Sau khi tạo DB bằng: npx wrangler d1 create thiepcuoi_d1 --remote
# Cập nhật database_id vào file wrangler.jsonc (không lưu bí mật vào đây)
# D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
